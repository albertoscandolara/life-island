# Copy to .env (git-ignored). Values here are local development defaults only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
NATS_PORT=4222
NATS_MONITOR_PORT=8222
STORAGE_S3_PORT=8333
GATEWAY_PORT=8080

# Per-service connection strings (each service uses only its own role).
INGESTION_DATABASE_URL=postgres://ingestion_svc:dev_ingestion@localhost:5432/life_island
REVIEW_DATABASE_URL=postgres://review_svc:dev_review@localhost:5432/life_island
GROCERY_DATABASE_URL=postgres://grocery_svc:dev_grocery@localhost:5432/life_island
TAX730_DATABASE_URL=postgres://tax730_svc:dev_tax730@localhost:5432/life_island
HOME_DATABASE_URL=postgres://home_svc:dev_home@localhost:5432/life_island
PEOPLE_DATABASE_URL=postgres://people_svc:dev_people@localhost:5432/life_island
CARS_DATABASE_URL=postgres://cars_svc:dev_cars@localhost:5432/life_island
# svc-work defaults to this when it is missing, so an older .env needs no change.
WORK_DATABASE_URL=postgres://work_svc:dev_work@localhost:5432/life_island
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=dev_access_key
S3_SECRET_KEY=dev_secret_key
S3_REGION=us-east-1
S3_BUCKET=uploads
# Endpoint the browser uses for presigned uploads and previews (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Front-end origins allowed to PUT files straight into the bucket.
STORAGE_CORS_ORIGINS=http://localhost:4201,http://localhost:4202,http://localhost:8080

# Service ports when run with `nx serve` (inside Docker every service listens on 3000).
INGESTION_PORT=3001
REVIEW_PORT=3002
GROCERY_PORT=3003
TAX730_PORT=3004
HOME_PORT=3005
PEOPLE_PORT=3006
CARS_PORT=3007
WORK_PORT=3008
# svc-review confirms on its own a parsed document with nothing to check (archive only); "false" sends everything to review.
# REVIEW_AUTO_CONFIRM=true
# svc-home keeps a PROPERTY category per home in svc-ingestion, so the review can put a bill on any of your homes.
# HOME_LINK_PROPERTY_CATEGORIES=true
# Where svc-tax730, svc-home, svc-people, svc-cars and svc-work read original files for the commercialista's zip (defaults to localhost:INGESTION_PORT),
# and where svc-review checks the reclassification lock before a write (unset: svc-review does not check).
# INGESTION_URL=http://localhost:3001
# Where svc-people reads the houses a person's Residence can point to (defaults to localhost:HOME_PORT).
# HOME_URL=http://localhost:3005
# Where svc-home and svc-cars read the people offered as house owners and car holders (defaults to localhost:PEOPLE_PORT).
# PEOPLE_URL=http://localhost:3006
# svc-home's own bucket for the houses' 3D models (it uses the S3_* settings above).
# HOME_S3_BUCKET=home-models
# svc-cars' own bucket for the cars' 3D models (same S3_* settings).
# CARS_S3_BUCKET=cars-models

# Gateway sign-in. Keep "off" only on your own machine; anything reachable from a
# network needs "basic" with a user and a bcrypt hash (infra/caddy/README.md).
GATEWAY_AUTH=off
GATEWAY_USER=
GATEWAY_PASSWORD_HASH=

# Parse worker. When the daily run starts: a time of day (06:00) or a cron expression.
PARSE_SCHEDULE=06:00
PARSE_TIMEZONE=Europe/Rome
# Also run once at startup, handy in development.
PARSE_RUN_ON_START=true
# Who reads your documents: "claude" or "fake" (any case).
#   fake   works offline with no key, but only spots keywords, totals and dates in file names
#          and PDF text. It cannot read photos or scans: an ID photo gets no category or details.
#   claude reads everything with the Claude API and needs ANTHROPIC_API_KEY below.
# A wrong value stops the parse worker at startup; restart npm run dev after changing it.
PARSER=fake
# Your Claude API key (sk-ant-...), from console.anthropic.com. Needed only with PARSER=claude.
# svc-work uses it too, for the career feedback; without it the feedback comes from its own rules.
ANTHROPIC_API_KEY=
# Model of the career feedback (svc-work).
# WORK_FEEDBACK_MODEL=claude-sonnet-5-5
# When the AI usage quota runs out and the provider gives no reset time, wait this long
# before checking again (doubling each time, up to the max).
PARSE_QUOTA_RETRY_MINUTES=360
PARSE_QUOTA_RETRY_MAX_MINUTES=1440
# Save AI-suggested categories without waiting for approval in the review UI.
CATEGORY_AUTO_APPROVE=false
# Historical reclassification: past documents checked against newer categories.
# Cron of the automatic run (monthly, 03:00 on the 1st); "off" leaves only Reclassify now.
RECLASSIFY_SCHEDULE=0 3 1 * *
RECLASSIFY_TIMEZONE=Europe/Rome
# Documents read per batch, and how long the run's lock survives a worker that stopped.
RECLASSIFY_BATCH_SIZE=50
RECLASSIFY_LEASE_MINUTES=5
# Model for the check (defaults to the classify model).
# RECLASSIFY_MODEL=
# Fake parser only: simulate a usage quota of N AI steps per period, to try the pause and resume.
FAKE_QUOTA_STEPS=0
FAKE_QUOTA_PERIOD_MINUTES=60
