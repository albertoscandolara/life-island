# Single origin for the front end. Each service is reached under /api/<service>/.
# Services that are not running yet answer 502 until they exist.
#
# Sign-in: GATEWAY_AUTH picks a file from ./auth (off or basic) for every route
# but the health check. See README.md in this folder.
{
	admin off
}

(protected) {
	import /etc/caddy/auth/{$GATEWAY_AUTH:off}.caddy
}

:80 {
	handle /healthz {
		respond "ok" 200
	}

	handle_path /api/ingestion/* {
		import protected
		reverse_proxy svc-ingestion:3000
	}
	handle_path /api/review/* {
		import protected
		reverse_proxy svc-review:3000
	}
	handle_path /api/groceries/* {
		import protected
		reverse_proxy svc-groceries:3000
	}
	handle_path /api/tax730/* {
		import protected
		reverse_proxy svc-tax730:3000
	}
	handle_path /api/home/* {
		import protected
		reverse_proxy svc-home:3000
	}
	handle_path /api/people/* {
		import protected
		reverse_proxy svc-people:3000
	}
	handle_path /api/cars/* {
		import protected
		reverse_proxy svc-cars:3000
	}
	handle_path /api/work/* {
		import protected
		reverse_proxy svc-work:3000
	}
	handle_path /api/settings/* {
		import protected
		reverse_proxy svc-settings:3000
	}
	handle_path /api/studies/* {
		import protected
		reverse_proxy svc-studies:3000
	}
	handle_path /api/fitness/* {
		import protected
		reverse_proxy svc-fitness:3000
	}
	handle_path /api/travel/* {
		import protected
		reverse_proxy svc-travel:3000
	}
	handle_path /api/subscriptions/* {
		import protected
		reverse_proxy svc-subscriptions:3000
	}
	handle_path /api/health/* {
		import protected
		reverse_proxy svc-health:3000
	}
	handle_path /api/goals/* {
		import protected
		reverse_proxy svc-goals:3000
	}
	handle_path /api/money/* {
		import protected
		reverse_proxy svc-money:3000
	}
	handle_path /api/agenda/* {
		import protected
		reverse_proxy svc-agenda:3000
	}

	handle {
		import protected
		respond "Life Island gateway" 200
	}
}
