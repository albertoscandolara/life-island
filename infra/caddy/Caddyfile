# Single origin for the front end. Each service is reached under /api/<service>/.
# Services that are not running yet answer 502 until they exist.
#
# Sign-in: every service checks the island's session cookie itself (svc-auth,
# docs/security.md). GATEWAY_AUTH adds an optional door in front: a file from
# ./auth (session, basic or off) for every route
# but the health check. It has no default: an unset value names no file and
# the gateway refuses to start, so a forgotten setting never publishes the
# island without sign-in. See README.md in this folder and docs/security.md.
{
	admin off
	servers {
		# Requests and headers bigger than this are refused before any service sees them.
		max_header_size 32KB
		# The visitor's address, for the services' rate limits and sign-in lockouts: a
		# proxy on this machine or network (Tailscale serve, Cloudflare Tunnel) passes it in
		# X-Forwarded-For. Taken only from private addresses, never from the internet.
		trusted_proxies static private_ranges
	}
}

(protected) {
	import /etc/caddy/auth/{$GATEWAY_AUTH}.caddy
}

(pages) {
	header Cache-Control "no-cache"
	# The pages load code only from the island itself: es-module-shims runs the areas'
	# modules from blob: URLs and puts the import map inline. Fonts come from Google
	# Fonts; services answer JSON on the same origin.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
}

(hardening) {
	header {
		# HTTPS only for a year once the site was opened over HTTPS (ignored over plain HTTP).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
	# Never pass on identity or internal headers a client made up.
	request_header -X-User-Id
	request_header -X-User-Role
	request_header -X-Internal-Token
	# Uploads go straight to storage; the largest body a service takes is a file
	# sent through the API (25 MB).
	request_body {
		max_size 26MB
	}
}

# SITE_ADDRESS: `:80` (the default) for plain HTTP behind something that adds HTTPS
# (Tailscale serve, Cloudflare Tunnel); a domain such as `island.example.com` for
# Caddy to get and renew its HTTPS certificate itself (docs/guides/publishing.md).
{$SITE_ADDRESS::80} {
	import hardening

	handle /healthz {
		respond "ok" 200
	}

	# Sign-in itself: the login page must reach it before anyone is signed in.
	handle_path /api/auth/* {
		import protected
		reverse_proxy svc-auth:3000
	}
	handle_path /api/ingestion/* {
		import protected
		reverse_proxy svc-ingestion:3000
	}
	handle_path /api/review/* {
		import protected
		reverse_proxy svc-review:3000
	}
	handle_path /api/groceries/* {
		import protected
		reverse_proxy svc-groceries:3000
	}
	handle_path /api/tax730/* {
		import protected
		reverse_proxy svc-tax730:3000
	}
	handle_path /api/home/* {
		import protected
		reverse_proxy svc-home:3000
	}
	handle_path /api/people/* {
		import protected
		reverse_proxy svc-people:3000
	}
	handle_path /api/cars/* {
		import protected
		reverse_proxy svc-cars:3000
	}
	handle_path /api/work/* {
		import protected
		reverse_proxy svc-work:3000
	}
	handle_path /api/settings/* {
		import protected
		reverse_proxy svc-settings:3000
	}
	handle_path /api/studies/* {
		import protected
		reverse_proxy svc-studies:3000
	}
	handle_path /api/fitness/* {
		import protected
		reverse_proxy svc-fitness:3000
	}
	handle_path /api/dreams/* {
		import protected
		reverse_proxy svc-dreams:3000
	}
	handle_path /api/travel/* {
		import protected
		reverse_proxy svc-travel:3000
	}
	handle_path /api/subscriptions/* {
		import protected
		reverse_proxy svc-subscriptions:3000
	}
	handle_path /api/health/* {
		import protected
		reverse_proxy svc-health:3000
	}
	handle_path /api/money/* {
		import protected
		reverse_proxy svc-money:3000
	}
	# The Agenda's private calendar link (docs/guides/calendar-feed.md): calendar
	# apps cannot sign in, so this one read-only path skips the gateway's door.
	# A longer path than /api/agenda/*, so Caddy tries it first. Only GET of a
	# 43-character secret reaches svc-agenda, which checks it; anything else is 404.
	handle_path /api/agenda/calendar/feed/* {
		@feed {
			method GET
			path_regexp ^/[A-Za-z0-9_-]{43}\.ics$
		}
		handle @feed {
			rewrite * /calendar/feed{path}
			reverse_proxy svc-agenda:3000
		}
		handle {
			respond 404
		}
	}
	handle_path /api/agenda/* {
		import protected
		reverse_proxy svc-agenda:3000
	}

	# Files go to and from storage with presigned links (docs/document-storage.md) on
	# this same origin, so storage needs no port or CORS of its own. The link's signature
	# is the permission; cookies stay here.
	handle /{$S3_BUCKET:uploads}/* {
		request_header -Cookie
		request_header -Authorization
		reverse_proxy storage:8333
	}

	# The pages (npm run site:build, or the `site` service, fills /srv). Hashed files
	# could be cached for ever, but the entry files cannot, so everything is
	# revalidated: the browser asks, and gets 304 when nothing changed.
	handle_path /documents/* {
		import protected
		import pages
		root * /srv/documents
		try_files {path} /index.html
		file_server
	}
	handle_path /mfe/* {
		import protected
		import pages
		root * /srv/mfe
		file_server
	}
	handle {
		import protected
		import pages
		root * /srv/shell
		try_files {path} /index.html
		file_server
	}
}
