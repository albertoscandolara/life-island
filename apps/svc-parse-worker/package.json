{
  "name": "@life-island/svc-parse-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Background AI parser: classifies stored documents and extracts their details on a schedule",
  "type": "module",
  "main": "./dist/main.js",
  "nx": {
    "name": "svc-parse-worker",
    "tags": [
      "type:app",
      "scope:ingestion"
    ],
    "targets": {
      "serve": {
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "command": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@life-island/be-common": "*",
    "@life-island/be-nest": "*",
    "@life-island/contracts": "*",
    "@life-island/ingestion-db": "*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  }
}
