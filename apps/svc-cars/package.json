{
  "name": "@life-island/svc-cars",
  "version": "0.0.1",
  "private": true,
  "description": "The Cars area: your cars with the fields of their carta di circolazione, their insurance, road tax, revisione and expenses, the review of new or different car data, new car suggestions, and renewal warnings",
  "type": "module",
  "main": "./dist/main.js",
  "nx": {
    "name": "svc-cars",
    "tags": [
      "type:app",
      "scope:cars"
    ],
    "targets": {
      "serve": {
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "command": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@life-island/be-common": "*",
    "@life-island/be-nest": "*",
    "@life-island/contracts": "*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.3.0"
  }
}
