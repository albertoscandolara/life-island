{
  "name": "documents",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/documents/src",
  "tags": ["type:app", "scope:documents"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/documents",
        "browser": "apps/documents/src/main.ts",
        "tsConfig": "apps/documents/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/documents/public"
          }
        ],
        "styles": [
          "libs/design-system/src/styles/index.css",
          "apps/documents/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/documents/src/environments/environment.ts",
              "with": "apps/documents/src/environments/environment.prod.ts"
            }
          ],
          "baseHref": "/documents/"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201,
        "proxyConfig": "apps/documents/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "documents:build:production"
        },
        "development": {
          "buildTarget": "documents:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "documents:build",
        "port": 4201,
        "staticFilePath": "dist/apps/documents/browser",
        "spa": true
      }
    }
  }
}
