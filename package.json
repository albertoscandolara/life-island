{
  "name": "@life-island/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "infra:up": "docker compose --project-directory . -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --project-directory . -f infra/docker-compose.yml down",
    "infra:reset": "docker compose --project-directory . -f infra/docker-compose.yml down -v",
    "db:check-isolation": "docker compose --project-directory . -f infra/docker-compose.yml exec -T postgres psql -U postgres -d life_island -v ON_ERROR_STOP=1 -f /checks/03-check-isolation.sql",
    "test:integration": "dotenv -e .env -- nx run-many -t test --skip-nx-cache"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "^24.0.0",
    "@nx/eslint-plugin": "^24.0.0",
    "@nx/js": "24.0.0",
    "@nx/vite": "^24.0.0",
    "@nx/vitest": "^24.0.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "~5.0.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "24.0.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
